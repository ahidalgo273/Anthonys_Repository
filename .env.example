# ─────────────────────────────────────────────────────────────────────────────
# DealerDesk environment variables
#
# Copy this file to `.env` and fill in what you need:
#
#     cp .env.example .env
#
# The app runs with NONE of these set. Every optional service degrades to a
# safe local fallback so you can develop and demo without accounts anywhere.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Your public URL, no trailing slash. Used for canonical links, the sitemap,
# and links inside emails. Leave the default for local development.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# ── Database (required) ──────────────────────────────────────────────────────
# SQLite by default — the file is created for you by `npx prisma migrate dev`.
# This is the only variable the app genuinely needs.
DATABASE_URL="file:./dev.db"
#
# To move to Postgres later, change the `provider` line in prisma/schema.prisma
# to "postgresql" and put your connection string here instead. Nothing else
# needs to change.


# ── Email ────────────────────────────────────────────────────────────────────
# "console" prints emails to your terminal (the default, perfect for testing).
#           Your portal sign-in links appear here.
# "resend"  actually sends them and requires RESEND_API_KEY below.
EMAIL_DRIVER="console"
# RESEND_API_KEY="re_..."
# EMAIL_FROM="DealerDesk <hello@yourdomain.com>"


# ── Stripe (test mode) ───────────────────────────────────────────────────────
# Without these, checkout runs in a clearly-labeled demo mode so you can walk
# the whole funnel without a Stripe account. Demo orders are marked so they
# never appear in your revenue numbers.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
#
# Price IDs, created in your Stripe dashboard. See the README for a walkthrough.
# STRIPE_PRICE_LICENSE_FILING="price_..."
# STRIPE_PRICE_COMPLIANCE="price_..."
# STRIPE_PRICE_SUITE_BUNDLE="price_..."
# STRIPE_PRICE_SUITE_SETUP="price_..."
# STRIPE_PRICE_ADDON_LLC_EIN="price_..."
# STRIPE_PRICE_ADDON_PHOTO_REVIEW="price_..."
# STRIPE_PRICE_ADDON_OCCUPATION_TAX="price_..."


# ── AI assistant ─────────────────────────────────────────────────────────────
# Added in Phase 5. Without a key, the assistant falls back to a static FAQ
# search and document checks fall back to deterministic rules. Nothing breaks.
# ANTHROPIC_API_KEY="sk-ant-..."


# ── File storage ─────────────────────────────────────────────────────────────
# Added in Phase 3. "local" writes uploads to ./storage on disk.
# STORAGE_DRIVER="local"


# ── Scheduled reminders ──────────────────────────────────────────────────────
# Added in Phase 3. A secret that protects the daily reminder job so only your
# scheduler can trigger it. Use any long random string.
# CRON_SECRET="change-me-to-something-long-and-random"
